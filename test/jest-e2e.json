{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testRegex": "\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "@swc/jest",
      {
        "swcrc": true
      }
    ]
  },
  "testEnvironment": "node",
  "testTimeout": 30000,
  "maxWorkers": 4,
  "globalSetup": "<rootDir>/test/global-setup.ts",
  "setupFiles": ["<rootDir>/test/setup-worker-db.ts", "<rootDir>/test/setup-loopback.ts"],
  "testSequencer": "<rootDir>/test/alphabetical-sequencer.js"
}
