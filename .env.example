# PostgreSQL 접속 정보 — docker-compose.yml 기본값과 일치
DATABASE_URL="postgresql://omf:omf@localhost:5432/omf_mes?schema=public"

# API 서버
# 3000은 로컬 Grafana 등이 점유하는 경우가 많아 3100을 기본값으로 둔다
PORT=3100
API_PREFIX=api
NODE_ENV=development

# 로컬 HTTP 개발에서는 Secure 쿠키를 끈다. TLS 프록시를 붙일 때만 true로 바꾼다.
COOKIE_SECURE=false

# 브라우저에서 직접 호출할 프런트엔드 개발 서버 오리진. 여러 개면 쉼표로 구분한다.
# * 하나면 어떤 오리진이든 연다(운영 기본값). 비우면 CORS 가 꺼진다.
CORS_ORIGINS=http://localhost:5173

# JWT 서명 키 — 32자 이상 필수. 없으면 서버가 기동하지 않는다.
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=28800

# 최초 관리자 초기 비밀번호. 빈 값이면 시드가 무작위 생성해 1회 출력한다.
ADMIN_INITIAL_PASSWORD=

# 첨부 파일 저장 경로 — 호스트의 «절대» 경로. 비우면 첨부 업로드·내려받기가 503 이다.
# 운영 compose 는 컨테이너 안 경로로 고정하므로 여기서만 쓴다.
#   ATTACHMENT_STORAGE_ROOT=/Users/me/omf-mes-attachments
ATTACHMENT_STORAGE_ROOT=

# ERP 연동 — 중계 DB(MSSQL)에서 기준정보를 받는다. 기본은 꺼짐.
# 로컬 중계 DB 는 erp-mock 저장소의 docker/ 로 띄운다. 켜면 접속 정보가 모두 있어야 기동한다.
ERP_SYNC_ENABLED=false
ERP_DB_HOST=127.0.0.1
ERP_DB_PORT=1433
ERP_DB_USER=mes-system
ERP_DB_PASSWORD=
ERP_DB_NAME=sample_mes
# 중계 DB 가 TLS 를 못 받으면 false.
ERP_DB_ENCRYPT=true
# ERP 통관번호 함수(「DB.dbo.ufn_M_CC_DTL_GetCC」). 비면 외자 구매입고도 통관번호를 빈 값으로 보낸다.
ERP_CC_FUNCTION=
# 기준정보를 받는 주기(초). 기본 43200(12시간).
ERP_SYNC_MASTER_INTERVAL_SEC=43200
# 발주·수주·제조오더를 받는 주기(초). 기본 900(15분).
ERP_SYNC_ORDER_INTERVAL_SEC=900

# Zalo 알림 발송(omf-all-around#160). 기본은 꺼짐 — 켜면 ZALO_CREDENTIAL_KEY 가 있어야 기동한다.
# 키는 연결 정보(비밀 키·토큰)를 DB 에 암호화해 두는 데 쓴다. 바꾸면 저장된 값을 다시 넣어야 한다.
#   openssl rand -base64 32
# 로컬 확인은 실제 Zalo 대신 테스트 대역(pnpm zalo:stub, 포트 3990)을 가리킨다.
ZALO_DELIVERY_ENABLED=false
ZALO_API_BASE_URL=http://127.0.0.1:3990
ZALO_OAUTH_BASE_URL=http://127.0.0.1:3990
ZALO_CREDENTIAL_KEY=
