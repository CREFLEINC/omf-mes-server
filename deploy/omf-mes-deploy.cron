# /etc/cron.d/omf-mes-deploy
#
# 매일 새벽 4시(서버 로컬시간)에 OMF MES 배포.
# 설치:
#   sudo cp omf-mes-deploy.cron /etc/cron.d/omf-mes-deploy
#   sudo chmod 644 /etc/cron.d/omf-mes-deploy
#   sudo systemctl restart cron
#
# 시간을 바꾸려면 아래 "0 4" 를 수정하세요 (분 시).
# 서버 타임존 확인: timedatectl | grep "Time zone"

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

0 4 * * *  root  cd /opt/omf-mes && ./deploy.sh >> /var/log/omf-mes-deploy.log 2>&1
