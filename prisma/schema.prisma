  approval_request                                       approval_request[]
  approval_route_step                                    approval_route_step[]
  approval_step                                          approval_step[]
  attachment                                             attachment[]
  document_cancellation                                  document_cancellation[]
  document_issue_log                                     document_issue_log[]                 @relation("document_issue_log_issued_by")
  reported_document_issue_log                            document_issue_log[]                 @relation("document_issue_log_print_reported_by")
  exception_case                                         exception_case[]
  handling_unit_repack_event                             handling_unit_repack_event[]
  idempotency_record                                     idempotency_record[]
  notice_notice_closed_byToapp_user                      notice[]                           @relation("notice_closed_byToapp_user")
  notice_notice_published_byToapp_user                   notice[]                           @relation("notice_published_byToapp_user")
  notice_acknowledgement                                 notice_acknowledgement[]
  notification                                           notification[]
  notification_subscription                              notification_subscription[]
  notification_subscription_recipient                    notification_subscription_recipient[]
  user_credential                                        user_credential?
  user_data_scope                                        user_data_scope[]
  user_role                                              user_role[]
  worker_lease                                           worker_lease[]
  handling_unit_reconfiguration                          handling_unit_reconfiguration[]
  inventory_count_line                                   inventory_count_line[]
  goods_issue                                            goods_issue[]
  goods_issue_spare_line                                 goods_issue_spare_line[]
  inbound_receipt                                        inbound_receipt[]
  material_issue_request                                 material_issue_request[]
  shipment_shipment_cancelled_byToapp_user               shipment[]                         @relation("shipment_cancelled_byToapp_user")
  shipment_shipment_confirmed_byToapp_user               shipment[]                         @relation("shipment_confirmed_byToapp_user")
  shopfloor_receipt                                      shopfloor_receipt[]
  subcontract_reconciliation                             subcontract_reconciliation[]
  breakdown                                              breakdown[]                        @relation("breakdown_reported_byToapp_user")
  breakdown_handled_by                                   breakdown[]                        @relation("breakdown_handled_byToapp_user")
  maintenance_order_assignee                             maintenance_order[]                @relation("maintenance_order_assignee_user")
  maintenance_order_issuer                               maintenance_order[]                @relation("maintenance_order_issued_by_user")
  maintenance_order_canceller                            maintenance_order[]                @relation("maintenance_order_cancelled_by_user")
  maintenance_result                                     maintenance_result[]
  equipment_downtime                                     equipment_downtime[]
  worker                                                 worker[]
  production_plan                                        production_plan[]
  precheck_decision                                      precheck_decision[]
  production_order_acknowledgement                       production_order_acknowledgement[]
  repair_execution                                       repair_execution[]
  work_session_event                                     work_session_event[]
  disposition_decision                                   disposition_decision[]
  equipment_calibration_performer                        equipment_calibration[]           @relation("equipment_calibration_calibrated_by")
  equipment_calibration_recorder                         equipment_calibration[]           @relation("equipment_calibration_recorded_by")
  equipment_calibration_clearer                          equipment_calibration[]           @relation("equipment_calibration_cleared_by")
  inspection_plan                                        inspection_plan[]
  nonconformance                                         nonconformance[]
  impact_analysis                                        impact_analysis[]
  lot_hold_lot_hold_held_byToapp_user                    lot_hold[]                         @relation("lot_hold_held_byToapp_user")
  lot_hold_lot_hold_released_byToapp_user                lot_hold[]                         @relation("lot_hold_released_byToapp_user")
  lot_status_event                                       lot_status_event[]

  @@index([department_id], map: "ix_app_user_department")
  @@schema("app")
