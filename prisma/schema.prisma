generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app", "audit", "integration", "inventory", "logistics", "mdm", "planning", "production", "quality", "trace"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model app_user {
  app_user_id                             BigInt                       @id @default(autoincrement())
  login_id                                String                       @unique @db.VarChar(100)
  user_name                               String                       @db.VarChar(200)
  department_id                           BigInt?
  email                                   String?                      @db.VarChar(200)
  status_code                             String                       @default("ACTIVE") @db.VarChar(50)
  is_active                               Boolean                      @default(true)
  created_at                              DateTime                     @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  created_by                              BigInt?
  updated_at                              DateTime                     @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  updated_by                              BigInt?
  version_no                              Int                          @default(1)
  department                              department?                  @relation(fields: [department_id], references: [department_id], onDelete: NoAction, onUpdate: NoAction)
  approval_request                        approval_request[]
  approval_route_step                     approval_route_step[]
  approval_step                           approval_step[]
  attachment                              attachment[]
  document_issue_log                      document_issue_log[]
  exception_case                          exception_case[]
  user_credential                         user_credential?
  user_data_scope                         user_data_scope[]
  user_role                               user_role[]
  inventory_count_line                    inventory_count_line[]
  inbound_receipt                         inbound_receipt[]
  material_issue_request                  material_issue_request[]
  shopfloor_receipt                       shopfloor_receipt[]
  subcontract_reconciliation              subcontract_reconciliation[]
  worker                                  worker[]
  production_plan                         production_plan[]
  work_session_event                      work_session_event[]
  disposition_decision                    disposition_decision[]
  equipment_calibration                   equipment_calibration[]
  inspection_plan                         inspection_plan[]
  nonconformance                          nonconformance[]
  impact_analysis                         impact_analysis[]
  lot_hold_lot_hold_held_byToapp_user     lot_hold[]                   @relation("lot_hold_held_byToapp_user")
  lot_hold_lot_hold_released_byToapp_user lot_hold[]                   @relation("lot_hold_released_byToapp_user")

  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model approval_request {
  approval_request_id  BigInt                 @id @default(autoincrement())
  approval_request_no  String                 @unique @db.VarChar(100)
  approval_type_code   String                 @db.VarChar(50)
  target_type_code     String                 @db.VarChar(50)
  target_id            BigInt
  requested_by         BigInt
  requested_at         DateTime               @db.Timestamptz(6)
  status_code          String                 @db.VarChar(50)
  reason               String
  created_at           DateTime               @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  updated_at           DateTime               @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  version_no           Int                    @default(1)
  app_user             app_user               @relation(fields: [requested_by], references: [app_user_id], onDelete: NoAction, onUpdate: NoAction)
  approval_step        approval_step[]
  inventory_adjustment inventory_adjustment[]
  inbound_receipt      inbound_receipt[]
  inbound_variance     inbound_variance[]
  concession           concession[]
  disposition_decision disposition_decision[]

  @@schema("app")
}

