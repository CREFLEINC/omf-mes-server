{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "typeCheck": true,
    "builder": {
      "type": "swc",
      "options": {
        "stripLeadingPaths": true,
        "ignore": ["**/*.spec.ts", "**/*.e2e-spec.ts"]
      }
    }
  }
}
