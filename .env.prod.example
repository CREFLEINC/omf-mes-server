# 배포용 환경변수 — 복사해서 .env.prod 로 쓴다.
#   cp .env.prod.example .env.prod
#
# .env.prod 는 커밋하지 않는다(.gitignore 처리됨).
# 비밀번호는 반드시 교체할 것 — 개발용 omf/omf 를 그대로 쓰지 말 것.

POSTGRES_USER=omf
POSTGRES_PASSWORD=반드시_교체할_것
POSTGRES_DB=omf_mes

# JWT 서명 키 — 32자 이상 필수. 배포마다 다른 값을 쓴다.
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=28800

# 세션 쿠키에 Secure 를 붙일지. ⛔ 앞단에 TLS 가 있을 때만 true 로 둔다.
# 지금 구성은 리버스 프록시 없이 평문 HTTP 로 API 를 노출하므로 켜면 브라우저가
# 쿠키를 되보내지 않아 관리웹 로그인이 통째로 안 된다(서버 로그에는 아무것도 안 남는다).
COOKIE_SECURE=false

# 브라우저가 «다른 오리진»에서 이 API 를 부를 수 있게 여는 목록 (관리웹 · PDA).
#
# * 하나면 «어떤 오리진이든» 연다 — 받은 Origin 을 그대로 반사한다. 현장 셸(PDA)이
# 보내는 오리진이 플랫폼·설정에 따라 갈려 미리 적을 수 없어 이것을 기본으로 둔다.
#
# ⛔ 비워 두면 CORS 가 «꺼진다». 그 상태에서는 preflight(OPTIONS)가 404 이고
#    브라우저 쪽에는 CORS 오류로만 보인다 — 서버 로그에는 아무것도 안 남는다.
#    기동 로그의 맨 끝이 "CORS 꺼짐" 인지 "CORS <목록>" 인지로 확인한다.
#
# ⛔⛔ COOKIE_SECURE 를 켜고 세션 쿠키를 SameSite=None 으로 바꾸려면, 그 «전에»
#    이 값을 * 에서 실제 목록으로 좁혀야 한다. 지금 * 가 안전한 것은 CORS 때문이
#    아니라 쿠키가 SameSite=Lax 라 교차 사이트 요청에 안 실리기 때문이다. Lax 를
#    풀면서 * 를 그대로 두면 아무 사이트나 로그인된 사용자의 세션으로 이 API 를
#    부를 수 있게 된다.
#
# 목록으로 좁힐 때의 값은 «오리진» 이다 — 도메인이나 IP 가 아니라 스킴+호스트+포트다.
#   · 끝에 / 를 붙이지 않는다
#   · 와일드카드·서브도메인 패턴·포트 생략이 없다. 글자 그대로 일치해야 한다
#   · http 와 https 는 서로 다른 오리진이다. TLS 를 앞에 두는 날 이 값도 함께 바꾼다
#   · 여러 개면 쉼표로 구분한다
#
#   CORS_ORIGINS=http://mes.example.lan,http://192.168.1.50:5173
CORS_ORIGINS=*

# 최초 관리자 비밀번호. 8자 이상으로 지정하고 평문으로 보관한다.
# 작은따옴표는 install-deploy.sh 및 Docker Compose 양쪽에서 안전하게 읽기 위해 사용한다.
ADMIN_INITIAL_PASSWORD='반드시_교체할_것'

# 호스트에 노출할 API 포트
API_PORT=3100

# ---- 이미지 소스 ----
# 서버에서 빌드하지 않고 Harbor 에서 받아온다.
REGISTRY=hub.crefle.com

# Harbor 자격증명 위치. 비워두면 배포 디렉터리 안의 .docker 를 쓴다
# (배포 디렉터리마다 다른 로봇 계정을 쓸 수 있다).
#
# ⚠️ 로그인을 반드시 같은 경로로 해야 한다. ~/.docker 에 로그인하면 안 먹는다.
#   docker --config /opt/omf-mes/.docker login hub.crefle.com -u 'robot$mes+server-pull'
#   chmod 700 /opt/omf-mes/.docker      # config.json 은 암호화가 아니라 base64 다
#
# 홈 기준 경로를 쓰려면 여기에 적는다. 셸에서 넘긴 값이 이 값보다 우선한다.
#DOCKER_CONFIG=/home/hulk/.docker-server-pull

# 배포할 이미지 태그.
#   main        : main 브랜치 최신 코드 — 개발 서버(한국)가 쓰는 값
#   stable      : git tag 로 릴리스한 검증된 버전 — 하노이 운영 서버
#   v1.2.3      : 특정 릴리스 고정 — 하노이 운영 서버 / 롤백 시
#   sha-a1b2c3d : 특정 커밋 고정 (핀포인트 디버깅 시)
#
# rollback.sh 가 이 값을 바꿉니다. 장애 대응으로 특정 버전에 고정했다면
# 상황 종료 후 `./rollback.sh main` 으로 되돌리는 걸 잊지 마세요.
IMAGE_TAG=main

# ---- 로그 표기 타임존 ----
# 컨테이너와 DB 는 UTC 로 돈다(docker-compose.prod.yml 의 타임존 정책 참조).
# 이 값은 deploy.sh 가 찍는 배포 로그의 표기 시각에만 영향을 준다.
#   개발 서버      Asia/Seoul
#   하노이 운영    Asia/Ho_Chi_Minh
LOG_TZ=Asia/Seoul
